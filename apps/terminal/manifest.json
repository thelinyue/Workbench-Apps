{
  "schemaVersion": 1,
  "id": "terminal",
  "name": "SSH 终端",
  "description": "保存连接、使用密码或私钥安全登录远程主机，并在多标签终端中进行运维操作",
  "publisherId": "thelinyue",
  "version": "2.0.0",
  "hostApiVersion": "1.0",
  "minWorkbenchVersion": "0.1.8",
  "window": {
    "defaultSize": { "width": 1440, "height": 900 },
    "minSize": { "width": 960, "height": 640 }
  },
  "runtime": {
    "rendererEntry": "renderer/index.html",
    "backendEntry": "backend/entry.js",
    "icon": "renderer/icon.svg"
  },
  "capabilities": [
    "ssh.credentials",
    "file.open",
    "file.save",
    "clipboard.read",
    "clipboard.write"
  ]
}
