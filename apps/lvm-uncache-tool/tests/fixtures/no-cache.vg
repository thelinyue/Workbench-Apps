contents = "Text Format Volume Group"
version = 1

test_vg {
    physical_volumes {
        pv0 {
            device = "/dev/test0"
            tags = []
        }
    }
    logical_volumes {
        data {
            segment_count = 1
            segment1 {
                type = "striped"
                stripes = ["pv0", 0]
            }
        }
    }
}
